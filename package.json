{
  "name": "ride48",
  "version": "4.8.3",
  "private": true,
  "productName": "Ride-4.8",
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "css": "grunt less",
    "test": "node tools/test-tauri.js",
    "test:unit": "node --test tests-node/*.js",
    "build": "tauri build",
    "clean": "node ./mk c",
    "test:build": "node tools/test-tauri.js --build-only",
    "test:connection": "node tools/test-tauri.js test/cn.js --match=cn-app-starts-ok --match=cn-fav-*",
    "monaco": "node tools/build-monaco.js",
    "test:ui-qa": "node tools/test-tauri.js test/startup-failure.js test/preferences-devtools.js test/window-layout.js test/session-lifecycle.js test/highlighting.js test/menu-actions.js test/connection-sizing.js test/mac-session-close.js test/monaco.js test/native-menu-routing.js test/output-menus.js",
    "stage": "npm run css && node tauri/stage.js",
    "build:zf": "npm run css && node mk zf"
  },
  "repository": ".",
  "dependencies": {
    "jquery": "^3.7.0",
    "monaco-editor": "^0.57.0",
    "toastr": "^2.1.4",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "ava": "^5.3.1",
    "cheerio": "^1.0.0-rc.12",
    "eslint": "^8.46.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "grunt": "^1.6.1",
    "grunt-contrib-less": "^3.0.0",
    "less": "^4.1.3",
    "less-plugin-glob": "^3.0.0",
    "webdriverio": "9.32.0",
    "esbuild": "^0.28.2",
    "@tauri-apps/cli": "2.12.1"
  },
  "ava": {
    "files": [
      "test/*.js"
    ]
  }
}
