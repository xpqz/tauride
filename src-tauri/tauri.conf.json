{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauride",
  "version": "../package.json",
  "identifier": "io.github.xpqz.tauride",
  "build": {
    "frontendDist": "../_/tauri-dist",
    "beforeDevCommand": "npm run css && node tauri/stage.js",
    "beforeBuildCommand": "npm run css && node tauri/stage.js"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false
  }
}
